{
  "name": "@reactive-agents/benchmarks",
  "version": "0.17.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test --reporter=dots",
    "bench": "bun run src/run.ts",
    "bench:t0": "bun test tests/t0-deterministic.test.ts",
    "bench:replay": "bun run src/replay-lane-cli.ts",
    "bench:replay:record": "bun run src/replay-record.ts",
    "bench:baseline": "bun run src/run.ts --session real-world-full --provider ollama --model cogito:8b --task rw-4,rw-8,rw-9 --variant manual-react,ra-full --runs 3 --save-baseline",
    "bench:drift": "bun run src/run.ts --session real-world-full --provider ollama --model cogito:8b --task rw-4,rw-8,rw-9 --variant manual-react,ra-full --runs 3 --ci"
  },
  "dependencies": {
    "effect": "^3.10.0",
    "@reactive-agents/core": "0.17.0",
    "@reactive-agents/trace": "0.17.0",
    "@reactive-agents/cost": "0.17.0",
    "@reactive-agents/judge-server": "0.17.0",
    "@reactive-agents/llm-provider": "0.17.0",
    "@reactive-agents/reasoning": "0.17.0",
    "@reactive-agents/replay": "0.17.0",
    "@reactive-agents/runtime": "0.17.0",
    "@reactive-agents/runtime-shim": "0.17.0",
    "@reactive-agents/tools": "0.17.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^1.0",
    "@ai-sdk/openai": "^1.0",
    "@langchain/anthropic": "^0.3",
    "@langchain/core": "^0.3",
    "@langchain/langgraph": "^0.2",
    "@langchain/openai": "^0.3",
    "@mastra/core": "^0.5",
    "@openai/agents": "^0.0",
    "ai": "^4.0",
    "bun-types": "latest",
    "llamaindex": "^0.8",
    "typescript": "^6.0.3",
    "zod": "^3.23"
  },
  "license": "MIT"
}
