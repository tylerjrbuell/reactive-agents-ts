{
  "component_type": "Agent",
  "id": "release-assistant",
  "name": "Release Assistant",
  "description": null,
  "metadata": {
    "reactive-agents": {
      "schemaVersion": 1,
      "config": {
        "persona": { "role": "release engineer", "tone": "concise" },
        "approvalPolicy": { "mode": "block", "tools": ["publish_release"] },
        "gateway": {
          "webhooks": [{ "path": "/hook", "adapter": "github", "secret": { "$env": "GATEWAY_HOOK_SECRET" } }]
        },
        "userInteraction": { "timeoutMs": 60000 }
      },
      "generatedId": true
    }
  },
  "inputs": [],
  "outputs": [],
  "system_prompt": "You prepare release notes.\n\nRole: release engineer\nTone: concise",
  "llm_config": {
    "component_type": "LlmConfig",
    "id": "release-assistant-llm",
    "name": "claude-sonnet-4-5",
    "description": null,
    "metadata": {},
    "model_id": "claude-sonnet-4-5",
    "default_generation_parameters": null,
    "provider": "anthropic",
    "api_key": { "$component_ref": "release-assistant-llm.api_key" }
  },
  "tools": [
    {
      "component_type": "ServerTool",
      "id": "tool-publish-release",
      "name": "publish_release",
      "description": "Publish a GitHub release",
      "metadata": {},
      "inputs": [{ "title": "tag", "type": "string" }],
      "outputs": [],
      "requires_confirmation": true
    }
  ],
  "toolboxes": [
    {
      "component_type": "MCPToolBox",
      "id": "mcp-github",
      "name": "github",
      "description": null,
      "metadata": {
        "reactive-agents": {
          "schemaVersion": 1,
          "server": { "headers": { "Authorization": { "$env": "MCP_GITHUB_AUTHORIZATION" } } }
        }
      },
      "client_transport": {
        "component_type": "StreamableHTTPTransport",
        "id": "mcp-github-transport",
        "name": "mcp-github-transport",
        "description": null,
        "metadata": {},
        "url": "https://api.example.com/mcp",
        "headers": null,
        "sensitive_headers": { "$component_ref": "mcp-github-transport.sensitive_headers" }
      },
      "tool_filter": null,
      "requires_confirmation": false
    }
  ],
  "human_in_the_loop": true,
  "agentspec_version": "26.1.2"
}
