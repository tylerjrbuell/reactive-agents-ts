---
/**
 * Install commands with one copy button each. Shared by TryIt (first screen of
 * entry pages) and EndOfPage (every page). Bun is recommended, Node 22.5+ is
 * supported (see guides/installation). Copy clicks fire the `install_copy`
 * Umami event from umami-deep.js, using `data-ra-placement`.
 */
interface Props {
  placement: string;
}
const { placement } = Astro.props;
const rows = [
  { label: "Bun (recommended)", cmd: "bun add reactive-agents" },
  { label: "Node 22.5+", cmd: "npm install reactive-agents" },
];
---

<div class="ra-install" data-ra-placement={placement}>
  {rows.map((r) => (
    <div class="ra-install-row">
      <code class="ra-install-cmd"><span class="ra-install-label">{r.label}</span>{r.cmd}</code>
      <button type="button" class="ra-install-copy" data-ra-copy={r.cmd} aria-label={`Copy: ${r.cmd}`}>Copy</button>
    </div>
  ))}
</div>

<script>
  // Delegated once per page; safe if the component renders several times.
  if (!document.documentElement.dataset.raInstallCopy) {
    document.documentElement.dataset.raInstallCopy = "1";
    document.addEventListener("click", async (ev) => {
      const target = ev.target as Element | null;
      const btn = target?.closest?.<HTMLButtonElement>("button[data-ra-copy]");
      if (!btn) return;
      const text = btn.dataset.raCopy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Press Ctrl+C";
      }
      setTimeout(() => { btn.textContent = "Copy"; }, 1500);
    });
  }
</script>
