---
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Default from "@astrojs/starlight/components/Head.astro";
import { siteVerification } from "../site-verification";

// Read the canonical release line from the repo-root VERSION file at build
// time so the SoftwareApplication schema never drifts (it previously hardcoded
// 0.12.0 while the site shipped v0.15). Falls back gracefully if unreadable.
let frameworkVersion = "0.15.0";
try {
  frameworkVersion = readFileSync(
    fileURLToPath(new URL("../../../../VERSION", import.meta.url)),
    "utf8",
  ).trim();
} catch {
  // keep fallback
}

// Canonical off-site profiles — Schema.org `sameAs` ties the SoftwareApplication
// entity to its GitHub / npm / community presences (entity consolidation for
// SERPs + answer engines).
const sameAs = [
  "https://github.com/tylerjrbuell/reactive-agents-ts",
  "https://www.npmjs.com/package/reactive-agents",
  "https://discord.gg/Mp99vQam3Q",
];

// Custom <head> override: layers social-preview images and JSON-LD
// structured data on top of Starlight's defaults. Two audiences:
//   1. Humans sharing links  -> og:image / twitter:image (per-page cards)
//   2. Search + answer engines -> Schema.org JSON-LD (rich SERP snippets,
//      AEO grounding for ChatGPT / Perplexity / Google AI Overviews)
const route = Astro.locals.starlightRoute;
const entry = route.entry;
const data = entry.data;

const site = Astro.site ?? new URL("https://docs.reactiveagents.dev");
const isHome = (entry.id || "index") === "index";

const canonical = new URL(route.slug ? `/${route.slug}/` : "/", site).href;
const ogImage = new URL("/og-default.png", site).href;

const title = data.title ?? "Reactive Agents";
const description =
  data.description ??
  "A composable TypeScript framework for building reliable LLM agents on a harness you fully control. The same code runs the full agent loop from a local 4B model to frontier APIs, with tool-call healing, verification, and durable crash-resume on a typed, observable 12-phase engine.";

const publisher = {
  "@type": "Organization",
  name: "Reactive Agents",
  url: "https://reactiveagents.dev",
  logo: "https://docs.reactiveagents.dev/favicon.svg",
  sameAs,
};

// Breadcrumb trail from the URL segments — surfaces site structure in SERPs.
const segments = (route.slug ?? "").split("/").filter(Boolean);
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Docs", item: site.href },
    ...segments.map((seg: string, i: number) => ({
      "@type": "ListItem",
      position: i + 2,
      name: seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
      item: new URL(`/${segments.slice(0, i + 1).join("/")}/`, site).href,
    })),
  ],
};

// Every doc page is a TechArticle — the schema answer engines prefer for
// developer documentation when grounding generated answers.
const article = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  url: canonical,
  image: ogImage,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "Reactive Agents Docs", url: site.href },
  author: publisher,
  publisher,
  ...(route.lastUpdated
    ? { dateModified: new Date(route.lastUpdated).toISOString() }
    : {}),
};

// Home page additionally describes the software itself.
const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Reactive Agents",
  alternateName: "reactive-agents",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Cross-platform (Node.js, Bun)",
  description:
    "A composable TypeScript framework for building reliable LLM agents on a harness you fully control. The same code runs the full agent loop from a local 4B model to frontier APIs, with tool-call healing, output verification, and durable crash-resume on a typed, observable 12-phase engine. Built on Effect-TS, MCP-native.",
  url: "https://reactiveagents.dev",
  downloadUrl: "https://www.npmjs.com/package/reactive-agents",
  installUrl: "https://www.npmjs.com/package/reactive-agents",
  softwareVersion: frameworkVersion,
  programmingLanguage: "TypeScript",
  runtimePlatform: "Node.js, Bun",
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  keywords:
    "TypeScript AI agent framework, LLM agents, agent harness, local model agents, Ollama tool calling, Effect-TS, MCP, ReAct, observable agents, LangChain alternative",
  featureList: [
    "Transparent 12-phase execution engine with per-phase before/after/on-error hooks",
    "Self-healing tool calls that repair malformed output from smaller models",
    "Same code runs on a local 4B model or a frontier API",
    "Composable opt-in capability layers (memory, guardrails, reasoning, cost)",
    "Signed evidence receipts and output verification for every run",
    "Pluggable reasoning strategies (ReAct, Reflexion, Plan-Execute, Tree-of-Thought) — bring your own",
    "MCP-native tool I/O and durable crash-resume",
  ],
  sameAs,
  author: publisher,
  publisher,
};

// The framework's source is itself an entity — helps answer engines link the
// docs, the package, and the repository as one project.
const sourceCode = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Reactive Agents",
  description:
    "Open-source TypeScript framework for building reliable, observable LLM agents on a harness you fully control.",
  codeRepository: "https://github.com/tylerjrbuell/reactive-agents-ts",
  programmingLanguage: "TypeScript",
  runtimePlatform: "Node.js, Bun",
  license: "https://opensource.org/licenses/MIT",
  author: publisher,
  sameAs,
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Reactive Agents Docs",
  url: site.href,
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${site.href}?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

// FAQPage — pages that declare a `faq` array in frontmatter emit Q&A
// structured data (Google featured snippets + answer-engine grounding).
const faqEntries = (data as { faq?: { q: string; a: string }[] }).faq;
const faqPage =
  faqEntries && faqEntries.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqEntries.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
      }
    : null;

const jsonLd = [
  ...(isHome ? [website, software, sourceCode] : [article]),
  breadcrumb,
  ...(faqPage ? [faqPage] : []),
];
---

<Default><slot /></Default>

{
  siteVerification.google && (
    <meta name="google-site-verification" content={siteVerification.google} />
  )
}
{
  siteVerification.bing && (
    <meta name="msvalidate.01" content={siteVerification.bing} />
  )
}

<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />

{
  jsonLd.map((schema) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
      is:inline
    />
  ))
}
