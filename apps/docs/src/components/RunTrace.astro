---
/**
 * RunTrace — the flagship "watch it work" evidence. A static, honest render
 * of ONE real run's tool-call trace: task in, real tool calls in the order
 * they happened, output out. No typewriter animation, no scripted dialogue —
 * raw evidence instead of a performance.
 *
 * Same golden-run.json every other evidence section on the page reads from.
 */
import data from '../data/golden-run.json'

const { task, model, run, toolCalls, output, receipt, capturedAt } = data
---

<div class="ra-hero-win ra-trace-win">
    <div class="ra-hero-winbar">
        <span class="ra-hero-tl-dot ra-hero-tl-r" />
        <span class="ra-hero-tl-dot ra-hero-tl-y" />
        <span class="ra-hero-tl-dot ra-hero-tl-g" />
        <span class="ra-hero-winttl">{model.id} · live run · {capturedAt}</span>
    </div>
    <div class="ra-trace-body">
        <p class="ra-trace-row ra-trace-task">
            <span class="ra-trace-label">task</span>
            <span class="ra-trace-val">{task.prompt}</span>
        </p>

        {toolCalls.map((tc, i) => (
            <p class="ra-trace-row ra-trace-call">
                <span class="ra-trace-idx">{String(i + 1).padStart(2, '0')}</span>
                <span class="ra-trace-tool">{tc.name}</span>
                <span class="ra-trace-args">{tc.argsPreview}</span>
            </p>
        ))}

        <p class="ra-trace-row ra-trace-out">
            <span class="ra-trace-label">output</span>
            <span class="ra-trace-val">{output}</span>
        </p>
    </div>
    <div class="ra-hero-verdict">
        <span class="ra-hero-vbadge">● {receipt.verdict}</span>
        <span class="ra-hero-vmeta">
            {run.iterations} iterations · {run.tokensUsed.toLocaleString()} tokens ·{' '}
            {(run.wallMs / 1000).toFixed(1)}s · <b>${run.cost.toFixed(4)}</b>
        </span>
    </div>
</div>
