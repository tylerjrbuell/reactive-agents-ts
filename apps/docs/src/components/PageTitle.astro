---
import TryIt from "./TryIt.astro";
import CopyPage from "./CopyPage.astro";
import { shouldShowTryIt } from "../content/try-it";
import { commitLink } from "../content/last-commit";
import MarkerIcon from "./MarkerIcon.astro";
import StabilityBadge from "./StabilityBadge.astro";
import WhatsNewToggle from "./WhatsNewToggle.astro";
import WhatChanged from "./WhatChanged.astro";
import {
  CURRENT_RELEASE,
  extractHeadings,
  extractSectionMarkers,
  indicatorsFor,
  pageMarkFor,
  tocMarks,
  type TocNode,
  type IndicatorFrontmatter,
} from "../content/indicators";

const route = Astro.locals.starlightRoute;
const data = route?.entry?.data ?? {};

const lastCommit = data.lastCommit as { hash: string; date: string } | undefined;
const indicators = indicatorsFor(data as IndicatorFrontmatter, CURRENT_RELEASE);
// Frontmatter marker, or section-only marks, with the section names in the tooltip.
const pageMark = pageMarkFor(
  data as IndicatorFrontmatter,
  extractSectionMarkers((route?.entry as { body?: string } | undefined)?.body ?? ""),
  CURRENT_RELEASE,
);

const commit = lastCommit ? commitLink(lastCommit) : undefined;

const id = route?.entry?.id ?? "";

// Try it placement rule lives in src/content/try-it.ts (allowlist, denylist,
// frontmatter `tryIt` override).
const pageId = id.replace(/\.(mdx?|md)$/, "").replace(/\/index$/, "");
const showTryIt = shouldShowTryIt(pageId, (data as { tryIt?: boolean }).tryIt);
const { sections: changed } = tocMarks(
  (route?.toc?.items ?? []) as TocNode[],
  extractHeadings((route?.entry as { body?: string } | undefined)?.body ?? ""),
  CURRENT_RELEASE,
  pageId,
);
---

<div class="ra-title-row">
  <h1 id="_top" class="ra-page-title" data-page-id={id}>
    {data.title}{pageMark && <MarkerIcon marker={{ kind: pageMark.kind, version: pageMark.version }} label={pageMark.label} />}
  </h1>
  {id && pageId !== "404" && <CopyPage id={id} />}
</div>

<div class="ra-title-meta">
  {indicators.stability && <StabilityBadge tier={indicators.stability} />}
  {lastCommit && (
    <span class="ra-last-updated">
      Last updated {lastCommit.date}
      {" · "}
      <a href={commit?.url} target="_blank" rel="noopener noreferrer">{commit?.label}</a>
    </span>
  )}
  <WhatsNewToggle />
</div>

<WhatChanged sections={changed} />

{showTryIt && <TryIt />}
