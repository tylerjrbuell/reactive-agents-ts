---
/**
 * PreferredSourceBadge — a tasteful "Add us as a preferred source on Google"
 * pill. Renders ONLY when src/preferred-source.ts has `enabled: true`, so it
 * is a no-op until the site is eligible and the official share link is set
 * (same opt-in discipline as site-verification.ts).
 *
 * Props:
 *   variant: "hero" (default, full label) | "compact" (short label, footer-sized)
 */
import { preferredSource } from '../preferred-source'

interface Props {
    variant?: 'hero' | 'compact'
}
const { variant = 'hero' } = Astro.props
const label =
    variant === 'compact' ? preferredSource.shortLabel : preferredSource.label
---

{
    preferredSource.enabled && (
        <a
            class:list={['ra-prefsrc', variant === 'compact' && 'ra-prefsrc--compact']}
            href={preferredSource.url}
            target="_blank"
            rel="noopener"
            data-umami-event="preferred-source-click"
        >
            <svg
                class="ra-prefsrc-g"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                aria-hidden="true"
            >
                <path
                    fill="#4285F4"
                    d="M23.52 12.27c0-.82-.07-1.6-.2-2.36H12v4.47h6.47a5.53 5.53 0 0 1-2.4 3.63v3h3.88c2.27-2.09 3.57-5.17 3.57-8.74z"
                />
                <path
                    fill="#34A853"
                    d="M12 24c3.24 0 5.96-1.08 7.95-2.92l-3.88-3c-1.08.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.28v3.1A12 12 0 0 0 12 24z"
                />
                <path
                    fill="#FBBC05"
                    d="M5.27 14.27a7.2 7.2 0 0 1 0-4.54v-3.1H1.28a12 12 0 0 0 0 10.74z"
                />
                <path
                    fill="#EA4335"
                    d="M12 4.77c1.76 0 3.35.61 4.6 1.8l3.44-3.44A11.95 11.95 0 0 0 12 0 12 12 0 0 0 1.28 6.63l3.99 3.1C6.22 6.88 8.87 4.77 12 4.77z"
                />
            </svg>
            <span class="ra-prefsrc-label">{label}</span>
            <svg
                class="ra-prefsrc-star"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                aria-hidden="true"
            >
                <path
                    fill="currentColor"
                    d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.8l-5.8 3.05 1.1-6.46-4.69-4.58 6.49-.94z"
                />
            </svg>
        </a>
    )
}
