---
// Client-only. Marks TOC links for headings that carry a <Since> marker,
// decorates hub/overview child lists with the New/Updated icon (data embedded
// by route-middleware.ts as #ra-marker-index), and gives group roll-up badges
// their tooltip. Page-level markers, sidebar glyphs and the title row are
// rendered server-side (route-middleware.ts, PageTitle.astro).
---

<script>
  import {
    HUB_LINK_SELECTOR,
    applyHubMarkers,
    applyTocSectionMarkers,
    parseMarkIndex,
    parseTocMarks,
  } from "../scripts/new-content-markers.js";

  function makeIcon(kind: "new" | "updated", label: string): HTMLElement {
    const el = document.createElement("span");
    el.className = "ra-marker-icon ra-ind ra-ind-marker";
    el.setAttribute("role", "img");
    el.setAttribute("data-ra-marker", kind);
    el.setAttribute("aria-label", label);
    el.title = label;
    return el;
  }

  function apply(): void {
    applyTocSectionMarkers(
      document.querySelectorAll<HTMLAnchorElement>("starlight-toc a[href], mobile-starlight-toc a[href]"),
      parseTocMarks(document.getElementById("ra-toc-markers")?.textContent),
    );

    const index = parseMarkIndex(document.getElementById("ra-marker-index")?.textContent);
    applyHubMarkers(
      document.querySelectorAll<HTMLAnchorElement>(HUB_LINK_SELECTOR),
      index,
      location.pathname.endsWith("/") ? location.pathname : `${location.pathname}/`,
      makeIcon,
      location.origin,
    );

    for (const badge of document.querySelectorAll<HTMLElement>(".sl-badge.ra-rollup")) {
      badge.title = badge.textContent ?? "";
    }
  }

  document.addEventListener("astro:page-load", apply);
  apply();
</script>
