---
/**
 * EvidenceReceipt — renders a REAL captured TrustReceipt as an inspectable
 * card. This is the on-brand proof surface: the framework's differentiator is
 * "verified, not vibes", so the landing shows an actual receipt from a real
 * run (gemma4:e4b, local, ~4B-class) rather than asserting the capability.
 *
 * Data is verbatim from a QA-probe run — see src/data/evidence-receipt.json,
 * which cites the source trace. The TrustReceipt schema is
 * packages/core/src/types/receipt.ts.
 */
import data from '../data/evidence-receipt.json'

const { task, model, receipt, checks } = data
const okChecks = checks.filter((c) => c.pass).length
const rawJson = JSON.stringify(
    {
        verdict: receipt.verdict,
        method: receipt.method,
        confidence: receipt.confidence,
        toolCallStats: receipt.toolCallStats,
        deliverables: receipt.deliverables,
        interventions: receipt.interventions,
        terminatedBy: receipt.terminatedBy,
        modelId: model.id,
        strategy: receipt.strategy,
        tokensUsed: receipt.tokensUsed,
        llmCalls: receipt.llmCalls,
        durationMs: receipt.durationMs,
    },
    null,
    2,
)
---

<figure class="ra-receipt-fig">
    <div class="ra-receipt-panel">
        <div class="ra-receipt">
            <!-- Header -->
            <div class="ra-receipt-head">
                <div class="ra-receipt-title">
                    <span class="ra-receipt-kicker">TrustReceipt</span>
                    <span class="ra-receipt-sub">evidence about <em>how</em> the answer was produced</span>
                </div>
                <span class:list={['ra-verdict', `ra-verdict--${receipt.verdict}`]}>
                    ● {receipt.verdict}
                </span>
            </div>

            <!-- Run identity -->
            <div class="ra-receipt-idrow">
                <span class="ra-chip ra-chip--model">{model.id}</span>
                <span class="ra-chip">{model.provider} · {model.tier}</span>
                <span class="ra-chip ra-chip--muted">{model.note}</span>
            </div>
            <p class="ra-receipt-task">{task.label}</p>

            <!-- Metric grid -->
            <div class="ra-receipt-metrics">
                <div><span class="rm-k">confidence</span><span class="rm-v">{receipt.confidence}</span></div>
                <div><span class="rm-k">tool calls failed</span><span class="rm-v rm-good">{receipt.toolCallStats.failed}</span></div>
                <div><span class="rm-k">llm calls</span><span class="rm-v">{receipt.llmCalls}</span></div>
                <div><span class="rm-k">tokens</span><span class="rm-v">{receipt.tokensUsed.toLocaleString()}</span></div>
                <div><span class="rm-k">duration</span><span class="rm-v">{(receipt.durationMs / 1000).toFixed(1)}s</span></div>
                <div><span class="rm-k">strategy</span><span class="rm-v">{receipt.strategy}</span></div>
                <div><span class="rm-k">terminated by</span><span class="rm-v">{receipt.terminatedBy}</span></div>
                <div><span class="rm-k">interventions</span><span class="rm-v">{receipt.interventions.length}</span></div>
            </div>

            <!-- Deliverables -->
            <div class="ra-receipt-section">
                <p class="ra-receipt-legend">Declared deliverables — checked against disk, not claimed</p>
                <ul class="ra-receipt-list">
                    {receipt.deliverables.map((d) => (
                        <li>
                            <span class:list={['ra-tick', d.produced ? 'ra-tick--ok' : 'ra-tick--miss']}>
                                {d.produced ? '✓' : '✗'}
                            </span>
                            <code>{d.spec}</code>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Verification ledger -->
            <div class="ra-receipt-section">
                <p class="ra-receipt-legend">
                    Deterministic verification ledger — {okChecks}/{checks.length} passed
                </p>
                <ul class="ra-receipt-checks">
                    {checks.map((c) => (
                        <li>
                            <span class:list={['ra-tick', c.pass ? 'ra-tick--ok' : 'ra-tick--miss']}>
                                {c.pass ? '✓' : '✗'}
                            </span>
                            <span class="ra-check-name">{c.name}</span>
                            <span class="ra-check-detail">{c.detail}</span>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Provenance footnote -->
            <p class="ra-receipt-foot">
                <code>verdict</code> grades the evidence trail, not the answer's truth. Add
                tamper-proof provenance with <code>.withReceiptSigning()</code> — an Ed25519
                signature over the receipt bytes, self-contained public key embedded.
            </p>

            <details class="ra-receipt-raw">
                <summary>View raw receipt JSON</summary>
                <pre><code>{rawJson}</code></pre>
            </details>
        </div>
    </div>
    <figcaption class="ra-receipt-cap">
        A <strong>real</strong> run captured 2026-07-11 on <code>{model.id}</code> — a
        ~4B-class local model. Every run returns one of these.
        <a href="/features/verification/">How verification works →</a>
    </figcaption>
</figure>
