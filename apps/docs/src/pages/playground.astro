---
// Full-page, in-house playground — a real full-viewport StackBlitz editor
// with our own chrome around it, not embedded inside a doc article's
// sidebar/TOC layout. Lives outside src/content/docs/ (plain Astro page)
// specifically to skip Starlight's page shell and get the whole viewport.
import '@fontsource-variable/geist'
import logoDark from '../assets/logo-dark.svg'

const SCENARIOS = [
    {
        id: 'hello-agent',
        label: 'Hello Agent',
        blurb: 'The simplest possible agent — one question, one answer.',
        project: '01-hello-agent',
    },
    {
        id: 'tool-integration',
        label: 'Tool Integration',
        blurb: 'Built-in tools running inside the WebContainer sandbox.',
        project: '02-tool-integration',
    },
    {
        id: 'strategy-demo',
        label: 'Strategy Demo',
        blurb: 'Two reasoning strategies, same task — compare steps and tokens.',
        project: '03-strategy-demo',
    },
]

const embedSrc = (project: string) =>
    `https://stackblitz.com/github/tylerjrbuell/reactive-agents-ts/tree/main/apps/stackblitz/${project}?embed=1&file=README.md,.env,src%2Fagent.ts&terminal=start&theme=dark&view=editor`
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playground · Reactive Agents</title>
    <meta name="description" content="Run a real Reactive Agents agent in your browser — no install. Powered by StackBlitz WebContainers." />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" />
    <script src="/coi-serviceworker.js" is:inline></script>
    <script is:inline>
        try {
            var t = localStorage.getItem('starlight-theme')
            if (t) document.documentElement.setAttribute('data-theme', t)
        } catch {}
    </script>
</head>
<body>
    <div class="pg-shell">
        <header class="pg-bar">
            <a class="pg-brand" href="/">
                <img src={logoDark.src} alt="" width="22" height="22" />
                <span>Reactive Agents</span>
            </a>
            <nav class="pg-tabs" role="tablist" aria-label="Playground scenario">
                {SCENARIOS.map((s, i) => (
                    <button
                        type="button"
                        class:list={['pg-tab', i === 0 && 'is-active']}
                        role="tab"
                        aria-selected={i === 0 ? 'true' : 'false'}
                        data-scenario={s.id}
                        title={s.blurb}
                    >
                        {s.label}
                    </button>
                ))}
            </nav>
            <a class="pg-guide-link" href="/guides/playground/">Setup guide →</a>
        </header>

        <div class="pg-frames">
            {SCENARIOS.map((s, i) => (
                <iframe
                    src={embedSrc(s.project)}
                    class="pg-frame"
                    data-frame={s.id}
                    hidden={i !== 0}
                    credentialless
                    allow="cross-origin-isolated"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    title={`${s.label} — Reactive Agents playground`}
                />
            ))}
        </div>
    </div>

    <style>
        :root {
            --pg-bg: #0b0c11;
            --pg-bar-bg: #12131a;
            --pg-hair: rgba(139, 92, 246, 0.16);
            --pg-text: #eceef2;
            --pg-text-dim: #888b96;
            --pg-violet: #8b5cf6;
            --pg-cyan: #06b6d4;
        }
        :root[data-theme='light'] {
            --pg-bg: #f6f6fb;
            --pg-bar-bg: #ffffff;
            --pg-hair: rgba(109, 40, 217, 0.14);
            --pg-text: #1e293b;
            --pg-text-dim: #64748b;
        }
        * {
            box-sizing: border-box;
        }
        html,
        body {
            margin: 0;
            height: 100%;
            background: var(--pg-bg);
            color: var(--pg-text);
            font-family: 'Geist Variable', 'Geist', ui-sans-serif, system-ui, sans-serif;
        }
        .pg-shell {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        .pg-bar {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            height: 3.25rem;
            padding: 0 1.1rem;
            background: var(--pg-bar-bg);
            border-bottom: 1px solid var(--pg-hair);
        }
        .pg-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 700;
            font-size: 0.92rem;
            color: var(--pg-text);
            text-decoration: none;
            flex-shrink: 0;
        }
        .pg-tabs {
            display: flex;
            gap: 0.35rem;
            flex: 1;
            overflow-x: auto;
        }
        .pg-tab {
            appearance: none;
            border: 1px solid var(--pg-hair);
            background: transparent;
            color: var(--pg-text-dim);
            font-family: inherit;
            font-size: 0.78rem;
            font-weight: 600;
            padding: 0.4rem 0.8rem;
            border-radius: 999px;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }
        .pg-tab:hover {
            border-color: rgba(139, 92, 246, 0.4);
            color: var(--pg-text);
        }
        .pg-tab.is-active {
            background: linear-gradient(135deg, var(--pg-violet) 0%, var(--pg-cyan) 100%);
            border-color: transparent;
            color: #fff;
        }
        .pg-guide-link {
            flex-shrink: 0;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--pg-text-dim);
            text-decoration: none;
            white-space: nowrap;
        }
        .pg-guide-link:hover {
            color: var(--pg-cyan);
        }
        .pg-frames {
            position: relative;
            flex: 1;
            min-height: 0;
        }
        .pg-frame {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }
        .pg-frame[hidden] {
            display: none;
        }
    </style>

    <script>
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-scenario]'))
        const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>('[data-frame]'))
        tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
                const target = tab.dataset.scenario
                tabs.forEach((t) => {
                    t.classList.toggle('is-active', t === tab)
                    t.setAttribute('aria-selected', String(t === tab))
                })
                frames.forEach((f) => {
                    f.hidden = f.dataset.frame !== target
                })
            })
        })
    </script>
</body>
</html>
