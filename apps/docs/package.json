{
  "name": "@reactive-agents/docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "metrics": "bun run scripts/generate-metrics.ts",
    "metrics:sync-readme": "bun run scripts/sync-readme-metrics.ts",
    "metrics:check": "bun run scripts/sync-readme-metrics.ts --check",
    "facts": "bun run scripts/derive-framework-facts.ts",
    "facts:check": "bun run scripts/derive-framework-facts.ts --check",
    "docs:indicators:suggest": "bun run scripts/indicators-suggest.ts",
    "golden-run": "bun run scripts/generate-golden-run.ts",
    "predev": "bun run scripts/generate-metrics.ts && bun run scripts/generate-golden-run.ts && bun run scripts/fetch-github-stats.ts",
    "prebuild": "bun run scripts/derive-framework-facts.ts && bun run scripts/generate-metrics.ts && bun run scripts/generate-golden-run.ts && bun run scripts/fetch-github-stats.ts",
    "dev": "astro dev",
    "build": "astro build && node scripts/skills-dist.mjs",
    "skills:check": "node scripts/skills-dist.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "0.43.1",
    "@fontsource-variable/geist": "^5.0.0",
    "astro": "7.4.12",
    "astro-skills": "^0.1.1",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "starlight-image-zoom": "^0.16.3",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-scroll-to-top": "^2.0.0"
  }
}
