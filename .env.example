# ── LLM Providers (at least one required) ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000

# Groq (OpenAI-compatible LPU inference — fast; no embeddings endpoint)
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # override (default shown)

# xAI (Grok — OpenAI-compatible; no embeddings endpoint)
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1               # override (default shown)

# Ollama (local — no API key needed)
OLLAMA_ENDPOINT=http://localhost:11434
# Ollama Cloud
OLLAMA_API_KEY=

# ── LLM Behaviour (optional) ──────────────────────────────────────────────────
LLM_DEFAULT_MODEL=claude-sonnet-4-20250514
LLM_MAX_RETRIES=3
LLM_TIMEOUT_MS=30000
LLM_DEFAULT_TEMPERATURE=0.7
# LLM_OBSERVABILITY_VERBOSITY=full   # full | metadata | minimal

# ── Embeddings (Tier 2 memory only) ───────────────────────────────────────────
EMBEDDING_PROVIDER=openai            # openai | ollama
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Web Search ─────────────────────────────────────────────────────────────────
# Provider chain: Tavily → Brave → Serper → DuckDuckGo (no key, limited)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=               # alternative: BRAVE_API_KEY
SERPER_API_KEY=                     # google.serper.dev — 2500 free queries/month

# ── GitHub Tools (shell-execution tool) ───────────────────────────────────────
GITHUB_TOKEN=

# ── Messaging Integrations ────────────────────────────────────────────────────
SIGNAL_PHONE_NUMBER=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# ── Cortex (local observability dashboard) ────────────────────────────────────
# CORTEX_URL=http://localhost:4321
# CORTEX_LOG=error                  # error | warn | info | debug

# ── Telemetry / Adaptive Calibration (optional — self-hosted) ─────────────────
# One base URL configures both read (/v1/profiles) and write (/v1/reports).
# Default: https://api.reactiveagents.dev (no config needed for cloud).
# REACTIVE_AGENTS_TELEMETRY_BASE_URL=https://your-server.example.com
# Per-endpoint overrides (take precedence over BASE_URL):
# REACTIVE_AGENTS_TELEMETRY_PROFILES_URL=https://your-server.example.com/v1/profiles
# REACTIVE_AGENTS_TELEMETRY_REPORTS_URL=https://your-server.example.com/v1/reports
# Override observations storage directory (default: ~/.reactive-agents/observations/):
# REACTIVE_AGENTS_OBSERVATIONS_DIR=/custom/path/to/observations
# Opt out of telemetry entirely (also honors the console DO_NOT_TRACK convention):
# REACTIVE_AGENTS_TELEMETRY=0
# Silence framework notices (e.g. the one-time "Reactive Intelligence" telemetry
# banner) without changing telemetry itself:
# REACTIVE_AGENTS_SUPPRESS_NOTICES=1

# ─── Harness mechanisms ───
# Prefer `.withHarness({...})` in code — it is typed, per-agent, and inherited by
# sub-agents. These variables are the FALLBACK layer: they apply only where the
# config does not decide, and they are process-global.
#
# RA_LAZY_TOOLS=0                    # off: disables lazy per-iteration tool disclosure pruning (default: on). Superseded by `.withHarness({ lazyDisclosure })`. Also the legacy fallback for RA_TOOL_DISCOVERY and RA_VERBOSE_RULES.
# RA_TOOL_DISCOVERY=0                # off: unregisters the `discover-tools` meta-tool (default: follows RA_LAZY_TOOLS). Superseded by `.withHarness({ toolDiscovery })`.
# RA_TOOL_INDEX=1                    # on: renders an always-visible name+one-line index of hidden tools (default: off). Superseded by `.withHarness({ toolIndex })`.
# RA_TOOL_INDEX_MAX_ENTRIES=20       # cap on index entries before "hybrid" mode truncates (default: unset = tier decides). Superseded by `.withHarness({ toolIndexMaxEntries })`.
# RA_VERBOSE_RULES=1                 # on: injects the verbose ReAct RULES block into the system prompt (default: off). Superseded by `.withHarness({ verboseRules })`.
# RA_STABLE_TOOL_SURFACE=1           # on: keeps the FC tools array byte-stable across iterations so the provider's prompt cache survives (default: off). Superseded by `.withHarness({ stableToolSurface })`.
# RA_RECENCY_BUDGET_CHARS=2000       # char budget override for recent observations (default: unset = derived from the context window). Superseded by `.withHarness({ recencyBudgetChars })`.
# RA_TOOL_RESULT_BUDGET_CHARS=800    # per-tool-result preservation cap override (default: unset = tier table decides). Superseded by `.withHarness({ toolResultBudgetChars })`.
# RA_THOUGHT_CONTINUITY=1            # on: replays the prior turn's recorded thought instead of empty content (default: off). Superseded by `.withHarness({ thoughtContinuity })`.
# RA_TOOL_OBSERVE_SYMMETRY=1         # on: single-tool-call path also attaches verification + semantic-memory writes, matching the batch path (default: off). Superseded by `.withHarness({ toolObserveSymmetry })`.
# RA_RATIONALE_AUDIT=1               # on: emits a per-tool-call rationale block for audit (default: off, decode-tax-only). Superseded by `.withHarness({ auditRationale })`.
# RA_TOT_EXPLORE_BUDGET_MS=120000    # Tree-of-Thought explore-phase wall-clock budget in ms (default: 120000). Superseded by `.withHarness({ treeOfThoughtExploreBudgetMs })`.
# RA_ASSEMBLY_DEBUG=1                # on: dumps the per-iteration projection trace to stderr (default: off, diagnostic only). Superseded by `.withHarness({ assemblyDebug })`.
# RA_PROMPT_DUMP=/tmp/ra-prompt      # writes each assembled prompt to `<prefix>-iter{N}-{taskId}.json` (default: unset = disabled). Superseded by `.withHarness({ promptDumpPathPrefix })`.
#
# Deployment-only switch, NOT part of HarnessConfig (build-time construction
# switch, not a per-run mechanism — see `runtime-construction.ts`):
# RA_OVERHAUL=1                      # on: registers the `write_result_to_file` meta-tool (overhaul/agentic-core branch, default: off)
