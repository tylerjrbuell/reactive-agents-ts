{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": ["bun-types"],
        "noImplicitReturns": true,
        "ignoreDeprecations": "6.0",
        "paths": {
            "@reactive-agents/reasoning/testing": ["./packages/reasoning/src/testing/index.ts"],
            "@reactive-agents/runtime/testing": ["./packages/runtime/src/testing/index.ts"],
            "@reactive-agents/core/internal/run-scope": ["./packages/core/src/internal/run-scope.ts"],
            "@reactive-agents/tools/internal/run-slots": ["./packages/tools/src/internal/run-slots.ts"],
            "@reactive-agents/*": ["./packages/*/src/index.ts"]
        }
    },
    "include": [
        "*.ts",
        "scripts/**/*",
        ".agents/**/*",
        "packages/*/tests/**/*",
        "packages/*/test/**/*",
        "packages/*/__tests__/**/*",
        "packages/*/scripts/**/*",
        "apps/*/tests/**/*",
        "apps/*/scripts/**/*"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/.turbo",
        "**/.svelte-kit",
        ".claude",
        "wiki",
        "apps/docs",
        "packages/benchmarks/mastra-vs-ra"
    ]
}
